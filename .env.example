# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
# Model name is configurable; check the current Gemini docs for supported models.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

# Optional partner application (leave empty to disable)
PARTNER_API_URL=
PARTNER_API_PATH=/recommend
PARTNER_API_KEY=

# Optional: enables retrieval of individual YouTube video URLs instead of a search page.
# Create a YouTube Data API key in Google Cloud and enable YouTube Data API v3.
# Search results are filtered against both course and topic where possible.
YOUTUBE_API_KEY=
